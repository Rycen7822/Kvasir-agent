{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "kind": {
      "const": "idea"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "content": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "record_id",
          "revision"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 20
        },
        "distinguishing_experiment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "falsification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "hypothesis",
        "alternatives",
        "distinguishing_experiment",
        "falsification"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "kind",
    "title",
    "content",
    "dependencies",
    "metadata"
  ],
  "additionalProperties": false
}
