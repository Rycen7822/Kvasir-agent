{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "kind": {
      "const": "source"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "content": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          }
        },
        "required": [
          "record_id",
          "revision"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "submitted_query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "effective_query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "coverage": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "fulltext",
                "abstract",
                "partial",
                "unavailable"
              ]
            },
            "truncated": {
              "type": "boolean"
            },
            "pages_received": {
              "type": "integer",
              "minimum": 0
            },
            "pages_total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "failure": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "mode",
            "truncated"
          ],
          "additionalProperties": false
        },
        "locators": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "lines"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "start",
                  "end",
                  "excerpt"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "page"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "page",
                  "excerpt"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 100
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "source_id",
        "version",
        "url",
        "retrieved_at",
        "coverage",
        "locators"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "kind",
    "title",
    "content",
    "dependencies",
    "metadata"
  ],
  "additionalProperties": false
}
