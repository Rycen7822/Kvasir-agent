{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "enum": [
              "wall_seconds",
              "cpu_seconds",
              "gpu_seconds",
              "tokens",
              "currency"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "basis": {
            "enum": [
              "observed",
              "estimated",
              "unknown"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "scope": {
            "enum": [
              "run",
              "search",
              "selected_candidate"
            ]
          }
        },
        "required": [
          "resource",
          "unit",
          "basis",
          "value",
          "scope"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          }
        ]
      },
      "maxItems": 200
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "entries"
  ],
  "additionalProperties": false
}
