{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "declared_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "timing": {
      "enum": [
        "prospective",
        "retrospective"
      ]
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "split": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "evaluator": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "selection": {
          "enum": [
            "last",
            "best",
            "prespecified"
          ]
        }
      },
      "required": [
        "name",
        "unit",
        "direction",
        "selection"
      ],
      "additionalProperties": false
    },
    "methods": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "additionalProperties": false
    },
    "method_inputs": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 200
        },
        "candidate": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 200
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "basis": {
          "const": "wall_timeout"
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 604800
        }
      },
      "required": [
        "basis",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "pair_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "seed": {
            "type": "integer"
          }
        },
        "required": [
          "pair_id",
          "task_id",
          "seed"
        ],
        "additionalProperties": false
      }
    },
    "failure_policy": {
      "const": "require_all_pairs"
    },
    "selection_rule": {
      "const": "unique_valid_attempt"
    },
    "statistics": {
      "const": "descriptive_only"
    }
  },
  "required": [
    "schema_version",
    "protocol_id",
    "declared_at",
    "timing",
    "environment_digest",
    "dataset_id",
    "split",
    "datasets",
    "evaluator",
    "metric",
    "methods",
    "method_inputs",
    "budget",
    "pairs",
    "failure_policy",
    "selection_rule",
    "statistics"
  ],
  "additionalProperties": false
}
